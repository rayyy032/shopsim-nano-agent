# Copy to .env and fill in. Any OpenAI-compatible endpoint works
# (DeepSeek / GLM / Qwen / Moonshot / local vLLM ...).

# Agent (the seven-stage pipeline) LLM
AGENT_API_KEY=sk-xxx
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# Shopper simulator LLM (can be the same endpoint; a stronger model makes
# the simulated user more realistic)
SHOPPER_API_KEY=sk-xxx
SHOPPER_BASE_URL=https://api.deepseek.com
SHOPPER_MODEL=deepseek-chat
